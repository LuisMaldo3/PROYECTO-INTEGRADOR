# Copia este archivo como ".env" (en la raíz de Usuario-back) y completa los valores.
# El archivo .env ya está en .gitignore: no lo subas al repositorio.

MONGODB_URI=mongodb://localhost:27017/vynk

# Google como proveedor de identidad
OAUTH_ISSUER=https://accounts.google.com
OAUTH_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs
# Debe ser EXACTAMENTE el mismo Client ID que usa el frontend (VITE_GOOGLE_CLIENT_ID)
OAUTH_CLIENT_ID=TU_CLIENT_ID.apps.googleusercontent.com

# Clave para firmar el JWT propio de VYNK (HS256). Mínimo 32 caracteres.
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres

# Orígenes del frontend permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173
