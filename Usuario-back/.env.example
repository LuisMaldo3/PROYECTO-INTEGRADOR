# Copia como .env y configura valores propios; nunca subir credenciales.
MONGODB_URI=mongodb://localhost:27017/vynk
JWT_SECRET=REEMPLAZAR_CON_UN_SECRETO_LARGO_Y_PRIVADO
CORS_ORIGINS=http://localhost:5173
DJANGO_SECRET_KEY=REEMPLAZAR_SI_USAS_DJANGO
DJANGO_DEBUG=False

# Opcional: modelo de Gemini capaz de generar imágenes, usa GEMINI_API_KEY ya existente.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
