# Copia este archivo como ".env" (en la raiz de Usuario-back, junto a pom.xml) y ajusta los valores.
# El archivo .env esta en .gitignore: NO lo subas al repositorio.
#
# Sin .env el backend NO arranca (falta JWT_SECRET).

# --- Base de datos ---------------------------------------------------------
# Opcion A: MongoDB local (debes tenerlo instalado y corriendo).
MONGODB_URI=mongodb://localhost:27017/vynk?serverSelectionTimeoutMS=5000&connectTimeoutMS=5000
# Opcion B: MongoDB Atlas. Pide el usuario/clave al dueno del cluster, y en Atlas ->
# Network Access agrega TU IP. Conserva los parametros de timeout al final:
# MONGODB_URI=mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/vynk?retryWrites=true&w=majority&serverSelectionTimeoutMS=5000

# --- Google (opcionales: ya tienen valor por defecto) ------------------------
OAUTH_ISSUER=https://accounts.google.com
OAUTH_JWKS_URI=https://www.googleapis.com/oauth2/v3/certs
# Debe ser EXACTAMENTE el Client ID *web* que usa la app (strings.xml -> google_server_client_id).
OAUTH_CLIENT_ID=451390492028-nrsbd0i4nbftbfjoe2htguebvk0mdi1r.apps.googleusercontent.com

# --- JWT propio de VYNK (HS256) --------------------------------------------
# Minimo 32 caracteres. Este valor sirve para desarrollo; en produccion usa uno propio y secreto.
JWT_SECRET=desarrollo-local-cambia-esto-por-un-secreto-largo-1234567890

# --- CORS (frontend web) ---------------------------------------------------
CORS_ORIGINS=http://localhost:5173

# --- IA: Gemini (asistente, recomendaciones y explicacion de cruces) --------
# Sin esta clave todo sigue funcionando, pero SIN IA (respuestas de respaldo).
# Crea la clave gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
