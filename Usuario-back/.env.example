# Copia este archivo como ".env" (junto a manage.py) y ajusta los valores.
# El archivo .env esta en .gitignore: NO lo subas al repositorio.

# --- Base de datos: LA MISMA que usa Usuario-back (base "vynk") -------------
MONGODB_URI=mongodb://localhost:27017/vynk

# --- JWT: DEBE SER EL MISMO JWT_SECRET que Usuario-back/.env -----------------
# Sirve para verificar los tokens que emite Spring Boot. Minimo 32 caracteres.
JWT_SECRET=cambia-esto-por-el-mismo-secreto-de-usuario-back

# --- CORS: origen de la web de administrador (React / Vite) -----------------
CORS_ORIGINS=http://localhost:5174

# --- Django ------------------------------------------------------------------
DJANGO_SECRET_KEY=clave-solo-para-desarrollo
DJANGO_DEBUG=true
