# Copia este archivo como ".env.local" y completa los valores.
# Después reinicia "npm run dev" (Vite solo lee las variables al arrancar).

# URL del backend (Spring Boot corre en el puerto 8081)
VITE_API_URL=http://localhost:8081

# Client ID de Google (Google Cloud Console > APIs y servicios > Credenciales).
# Debe ser EXACTAMENTE el mismo que OAUTH_CLIENT_ID en el backend.
VITE_GOOGLE_CLIENT_ID=TU_CLIENT_ID.apps.googleusercontent.com
