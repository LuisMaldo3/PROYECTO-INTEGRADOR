<?xml version="1.0" encoding="utf-8"?>
<!--
   Reglas del respaldo automático y de la transferencia entre celulares (Android 12 y posteriores).
   La sesión de VYNK (token) NO se respalda ni se copia a otro celular.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="vynk_sesion.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="vynk_sesion.xml" />
    </device-transfer>
</data-extraction-rules>
